@inreference{GeschichteKryptographie2026,
  title = {Geschichte der Kryptographie},
  booktitle = {Wikipedia},
  date = {2026-05-17T18:34:30Z},
  url = {https://de.wikipedia.org/w/index.php?title=Geschichte_der_Kryptographie&oldid=267155855},
  urldate = {2026-10-05},
  abstract = {Die Geschichte der Kryptographie (geschrieben auch: Kryptografie), also die Verschlüsselung von Texten, Nachrichten oder Daten zum Zwecke der Geheimhaltung, lässt sich in drei Zeiträume aufteilen. Im ersten wurde per Hand (zum Beispiel „mit Papier und Bleistift“ oder auch mit mechanischen Scheiben) verschlüsselt, im zweiten (etwa 1920 bis 1970) wurden spezielle Maschinen verwendet, im dritten (etwa seit 1970) übernahmen Computer eine zentrale Rolle. Die Kryptoanalyse (auch: Kryptanalyse) bildet das ergänzende Gegenstück zur Kryptographie. Dabei werden Methoden erforscht, um kryptographische Verfahren zu analysieren und möglichst zu brechen (Entzifferung). Kryptographie und Kryptoanalyse sind Teilgebiete der Kryptologie. Nur wenige sehr alte Systeme sind bekannt. Ein Beispiel ist die Caesar-Verschlüsselung (auch: Cäsar-Chiffre) der alten Römer. Durch Neuentdeckungen von Dokumenten aus Altertum und Antike sowie durch Öffnung von Archiven, Zeitzeugenbefragungen können die Kenntnisse über kryptographische Systeme der Vergangenheit erweitert werden.},
  langid = {ngerman},
  file = {C:\Users\lukic\Zotero\storage\XYNH9IGK\index.html}
}

